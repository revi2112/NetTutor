# Copy to .env and fill in. Defaults shown.
DATABASE_URL=postgresql://nettutor:nettutor@localhost:5433/nettutor

# Needed from session 5 (Claude calls). Leave blank until then.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5

EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

RETRIEVAL_MODE=hybrid
TOP_K=6
ON_TOPIC_THRESHOLD=0.5

# Used by docker-compose for the dev database
POSTGRES_USER=nettutor
POSTGRES_PASSWORD=nettutor
POSTGRES_DB=nettutor
POSTGRES_PORT=5433
